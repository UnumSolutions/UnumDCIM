{
  "origin": "https://customer-approved-host.invalid",
  "auth": {
    "scheme": "Bearer",
    "token_env": "NLYTE_DISCOVERY_TOKEN"
  },
  "limits": {
    "timeout_seconds": 5,
    "max_duration_seconds": 30,
    "max_pages": 10,
    "max_page_bytes": 500000,
    "max_records": 1000
  },
  "collections": [
    {
      "name": "synthetic_assets",
      "path": "/synthetic/assets",
      "allowed_paths": ["/synthetic/assets"],
      "allowed_query_parameters": ["limit", "cursor"],
      "page_size_parameter": "limit",
      "page_size": 2,
      "items_path": "/records",
      "identity_path": "/id",
      "revision_path": "/version",
      "fields": {"display_name": "/name", "rack_reference": "/rack"},
      "next_path": "/next",
      "missing_next_is_terminal": false,
      "completion": {"kind": "total_count", "path": "/total"}
    }
  ]
}
