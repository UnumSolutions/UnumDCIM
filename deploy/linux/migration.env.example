# Template only. Use this file for the single migration command, never application replicas.
UNUM_DEMO=0
UNUM_SECRET_KEY=REPLACE_WITH_RANDOM_APPLICATION_SECRET
PGHOST=postgres.example.internal
PGPORT=5432
PGDATABASE=unum_inventory
PGUSER=unum_inventory_migration
PGPASSWORD=REPLACE_WITH_MIGRATION_DATABASE_PASSWORD
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/unum/trust/postgres-ca.crt
