# Template only. Replace placeholders and provision /etc/unum/<module>.env mode 0600.
# Use one application credential/role/database per module; never use the migration role here.
UNUM_DEMO=0
UNUM_SECRET_KEY=REPLACE_WITH_RANDOM_APPLICATION_SECRET
UNUM_ALLOWED_HOSTS=inventory.example.internal
PGHOST=postgres.example.internal
PGPORT=5432
PGDATABASE=unum_inventory
PGUSER=unum_inventory_app
PGPASSWORD=REPLACE_WITH_APPLICATION_DATABASE_PASSWORD
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/unum/trust/postgres-ca.crt
# Direct PostgreSQL or a SESSION pool only. Transaction/statement pooling is unsupported.
UNUM_OIDC_ISSUER=https://identity.example.internal/realms/unum
UNUM_OIDC_AUDIENCE=unum-api
UNUM_OIDC_JWKS_URI=https://identity.example.internal/realms/unum/protocol/openid-connect/certs
UNUM_OIDC_SCOPE=unum.api
UNUM_OIDC_ROLE_CLAIM=unum_role
UNUM_OIDC_TENANT_CLAIM=unum_tenant
UNUM_OIDC_SITES_CLAIM=unum_sites
UNUM_OIDC_MFA_ACR_VALUES=[]
# Configure incoming machine credentials with explicit tenant/site grants. Human static tokens are rejected.
UNUM_AUTH_TOKENS={"REPLACE_WITH_INCOMING_SERVICE_TOKEN":{"actor":"workflow-service","role":"service","tenant":"REPLACE_TENANT","sites":["REPLACE_SITE"]}}
# Workflow uses this outbound token; it must match the scoped incoming grant on inventory/placement.
UNUM_SERVICE_TOKEN=REPLACE_WITH_OUTGOING_SERVICE_TOKEN
UNUM_SERVICE_URLS={"inventory":"https://inventory.example.internal","placement":"https://placement.example.internal"}
UNUM_NATS_URL=tls://nats.example.internal:4222
